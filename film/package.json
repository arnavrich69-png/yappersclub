{
  "name": "dhwanikul-film",
  "private": true,
  "version": "0.1.0",
  "description": "Dhwanikul logo film and motion pieces, built with Remotion",
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "audio": "node scripts/prepare-audio.mjs",
    "proof": "node scripts/render-proof.mjs",
    "typecheck": "tsc --noEmit",
    "film": "node scripts/render-film.mjs",
    "open-call": "node scripts/render-open-call.mjs",
    "score": "node scripts/make-score.mjs",
    "hero": "node scripts/render-open-call-hero.mjs",
    "open-call-film": "node scripts/render-open-call-film.mjs",
    "lyric:setup": "bash lyric/tools/setup.sh",
    "lyric:timing": "bash lyric/tools/run.sh timing.py",
    "lyric:analyse": "bash lyric/tools/run.sh analyse.py",
    "lyric:sync": "node scripts/lyric-sync-test.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.527",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.527"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "typescript": "5.9.2"
  }
}
